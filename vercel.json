{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "crons": [
    {
      "path": "/api/cleanup-cloudinary",
      "schedule": "0 1 * * *"
    }
  ],

  "rewrites": [
    {
      "source": "/tv",
      "destination": "/display.html"
    },
    {
      "source": "/tv/:branch",
      "destination": "/display.html?branch=:branch"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
