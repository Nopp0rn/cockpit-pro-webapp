{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/tv",
      "destination": "/display.html"
    },
    {
      "source": "/tv/:branch",
      "destination": "/display.html?branch=:branch"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
