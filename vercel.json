{
  "rewrites": [
    {
      "source": "/tv",
      "destination": "/display.html"
    },
    {
      "source": "/tv/:branch",
      "destination": "/display.html?branch=:branch"
    },
    {
      "source": "/((?!display\\.html|icons|manifest\\.json|sw\\.js|register\\.html).*)",
      "destination": "/"
    }
  ]
}
